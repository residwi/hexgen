# Build stage
FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/api ./cmd/api{{if .Worker}} && \
  CGO_ENABLED=0 GOOS=linux go build -o /bin/worker ./cmd/worker{{end}}

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /bin/api /bin/api
{{- if .Worker}}
COPY --from=builder /bin/worker /bin/worker
{{- end}}
COPY --from=builder /app/db/migrations /db/migrations

EXPOSE 8080

CMD ["/bin/api"]
