package main

import (
	"context"
	"fmt"
	"log"
	"log/slog"
	"os/signal"
	"syscall"
	"time"

	"github.com/residwi/go-api-project-template/internal/config"
	"github.com/residwi/go-api-project-template/internal/platform/jobs"
	"github.com/residwi/go-api-project-template/internal/platform/logger"
)

func main() {
	if err := run(); err != nil {
		log.Fatal(err)
	}
}

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("loading config: %w", err)
	}

	logger.Setup(cfg.Log.Level, cfg.Log.Format)

	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	// TODO: connect your stores (e.g. database.NewPostgres(ctx, cfg.Database))
	// and back exampleQueue with a real job table; exampleProcessor does the work.
	// The runner claims a leased batch each tick, processes jobs concurrently,
	// and prunes finished rows.
	runner := jobs.NewRunner[exampleJob](
		"worker",
		exampleQueue{},
		exampleProcessor{},
		jobs.Config{
			Interval:      cfg.Worker.Interval,
			BatchSize:     cfg.Worker.BatchSize,
			LeaseDuration: cfg.Worker.LeaseDuration,
			Concurrency:   cfg.Worker.Concurrency,
			PruneAge:      cfg.Worker.PruneAge,
			PruneLimit:    cfg.Worker.PruneLimit,
		},
	)

	slog.Info("worker starting", "env", cfg.App.Env)
	runner.Start(ctx)
	slog.Info("worker stopped")
	return nil
}

// exampleJob is a placeholder job type. Replace it with your own.
type exampleJob struct {
	ID string
}

// exampleQueue is a placeholder jobs.Queue. Back it with a real job table:
// Claim leases a batch (e.g. SELECT ... FOR UPDATE SKIP LOCKED), and Prune
// removes finished rows so the table stays bounded.
type exampleQueue struct{}

func (exampleQueue) Claim(_ context.Context, _ int, _ time.Duration) ([]exampleJob, error) {
	return nil, nil
}

func (exampleQueue) Prune(_ context.Context, _ time.Duration, _ int) (int, error) {
	return 0, nil
}

// exampleProcessor is a placeholder jobs.Processor. Replace Process with the
// per-job work.
type exampleProcessor struct{}

func (exampleProcessor) Process(ctx context.Context, job exampleJob) error {
	slog.InfoContext(ctx, "processing job", "id", job.ID)
	return nil
}
