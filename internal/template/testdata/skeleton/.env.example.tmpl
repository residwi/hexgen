# Application
APP_NAME=__PROJECT_NAME__
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=30s
# Comma-separated CIDRs of the reverse proxies / load balancers in front of
# this app. X-Forwarded-For and X-Real-IP are trusted ONLY for peers in these
# CIDRs. Leave it empty and the app trusts NO forwarding headers: it keys every
# request on the immediate connection address, so a caller cannot spoof its
# rate-limit key. Only the listed CIDRs are trusted, so list every hop,
# including a sidecar proxy on 127.0.0.1/32.
# MUST be set whenever a proxy fronts the app. If it stays empty behind a proxy,
# every client arrives as the proxy's single address and shares ONE rate-limit
# bucket, so one caller hammering the API can 429 every other client. (The app
# logs a one-time warning if it sees forwarding headers from an internal peer
# while this is empty.)
TRUSTED_PROXIES=
# Per-IP ceiling for every /api route, counted before any authentication so
# requests with junk tokens are throttled too. Clients behind one shared IP
# (office or carrier NAT) share this budget; size it for your largest one.
API_RATE_LIMIT=600
API_RATE_WINDOW=1m

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=__PROJECT_NAME__
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_SESSION_TIMEOUT=60s
REPLICA_DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
{{- if .Auth}}

# JWT
# Generate a unique value: openssl rand -hex 32
# Boot fails if this is left as the placeholder or is shorter than 32 bytes.
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=__PROJECT_NAME__
{{- end}}

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS. Comma-separated browser origins. Unset means no cross-origin access.
# * is safe only while auth is Bearer-token with no cookies; list explicit
# origins before adding any cookie- or session-based login.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,Idempotency-Key
CORS_MAX_AGE=86400
{{- if .Auth}}

# Auth tuning
# AUTH_RATE_WINDOW must be >= 1s -- auth.LoadConfig() fails fast below that,
# as a deliberate minimum window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
BCRYPT_COST=10
{{- end}}

# Redis connection pool
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_TIMEOUT=1s

# Tracing: "none" (the default, same as unset) registers no provider; "otlp" with an endpoint turns it on, or "console" prints spans to stdout.
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SERVICE_NAME=
