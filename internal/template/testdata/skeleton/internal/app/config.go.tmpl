package app

import (
{{- if .Auth}}
	"fmt"

{{end}}
	"github.com/redis/go-redis/v9"

	"__MODULE__/internal/config"
{{- if .Auth}}
	"__MODULE__/internal/features/auth"
{{- end}}
	"__MODULE__/internal/platform/database"
)

// Config holds each feature module's own env config.
{{if .Auth -}}
type Config struct {
	Auth auth.Config
}
{{- else -}}
type Config struct{}
{{- end}}

func PoolOptions(cfg config.Database) database.PostgresOptions {
	return database.PostgresOptions{
		DSN:             cfg.DSN(),
		MaxConns:        cfg.MaxConns,
		MinConns:        cfg.MinConns,
		MaxConnLifetime: cfg.MaxConnLifetime,
		MaxConnIdleTime: cfg.MaxConnIdleTime,
	}
}

func ReplicaPoolOptions(cfg config.Database) database.PostgresOptions {
	opts := PoolOptions(cfg)
	opts.DSN = cfg.ReplicaURL

	return opts
}

func RedisOptions(cfg config.Redis) *redis.Options {
	return &redis.Options{
		Addr:         cfg.Addr(),
		Password:     cfg.Password,
		DB:           cfg.DB,
		PoolSize:     cfg.PoolSize,
		MinIdleConns: cfg.MinIdleConns,
		DialTimeout:  cfg.DialTimeout,
		ReadTimeout:  cfg.ReadTimeout,
		WriteTimeout: cfg.WriteTimeout,
		PoolTimeout:  cfg.PoolTimeout,
		// One attempt per command. Retrying is wasted work when the fallback is a
		// Postgres read, and against a server that accepts but never answers the
		// default of 3 multiplies every socket timeout by four.
		MaxRetries: -1,
	}
}

func LoadConfig() (Config, error) {
{{- if .Auth}}
	authCfg, err := auth.LoadConfig()
	if err != nil {
		return Config{}, fmt.Errorf("loading auth config: %w", err)
	}

	return Config{Auth: authCfg}, nil
{{- else}}
	return Config{}, nil
{{- end}}
}
