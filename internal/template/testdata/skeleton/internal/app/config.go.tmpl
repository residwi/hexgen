package app

import (
{{- if .Auth}}
	"fmt"

{{end}}
	"github.com/residwi/go-api-project-template/internal/config"
{{- if .Auth}}
	"github.com/residwi/go-api-project-template/internal/features/auth"
{{- end}}
	"github.com/residwi/go-api-project-template/internal/platform/database"
)

// Config holds each feature module's own env config.
{{if .Auth -}}
type Config struct {
	Auth auth.Config
}
{{- else -}}
type Config struct{}
{{- end}}

func PoolOptions(cfg config.Database) database.PostgresOptions {
	return database.PostgresOptions{
		DSN:             cfg.DSN(),
		MaxConns:        cfg.MaxConns,
		MinConns:        cfg.MinConns,
		MaxConnLifetime: cfg.MaxConnLifetime,
		MaxConnIdleTime: cfg.MaxConnIdleTime,
	}
}

func ReplicaPoolOptions(cfg config.Database) database.PostgresOptions {
	opts := PoolOptions(cfg)
	opts.DSN = cfg.ReplicaURL

	return opts
}

func LoadConfig() (Config, error) {
{{- if .Auth}}
	authCfg, err := auth.LoadConfig()
	if err != nil {
		return Config{}, fmt.Errorf("loading auth config: %w", err)
	}

	return Config{Auth: authCfg}, nil
{{- else}}
	return Config{}, nil
{{- end}}
}
